//@version=6
indicator("Hidden Orderblocks", shorttitle = "HOB", overlay = true, max_boxes_count = 500)

// -----------------------------------------------------------------------------
// HIDDEN ORDERBLOCK
// A candle body (open->close) that price has only ever crossed *inside* an FVG.
// Every time price skips over the body via an FVG that covers the WHOLE body,
// the body becomes one level more "hidden" (1x, 2x, 3x ...).
// Any other candle trading into the body (wick or body) mitigates it -> dead.
//
// Rules, for candidate candle Z:
//   * Z's colour must match the first FVG that hides it. On the chart, zones above
//     price show as bearish (resistance) and below price as bullish (support).
//   * The candle straight after Z may cross the body only by closing beyond its
//     far side (the move away). A wick back into the body mitigates it.
//   * From then on, for every candle M that enters the body (judged when M closes):
//       - M is an FVG candle crossing the whole body       -> hidden += 1
//           bearish: low[M-1] >= bodyTop and low[M] <= bodyBot
//           bullish: high[M-1] <= bodyBot and high[M] >= bodyTop
//         (the candle after M must stay out of the body, or it mitigates the zone)
//         The FIRST covering FVG must be the zone's colour; once confirmed,
//         later FVGs of either colour add a level. The candle after M must leave
//         the gap open (bearish: high <= bodyBot, bullish: low >= bodyTop), or the
//         zone is mitigated.
//       - a wick only into the outer touch buffer           -> allowed, marked touched
//       - otherwise (any wick or body into it)              -> mitigated
//   * Junk filter: the body must be at least 0.15x the 14-candle ATR (setting).
// -----------------------------------------------------------------------------

const string G_DET = "Detection"
int   minHidden  = input.int(1, "Min hidden count to show", minval = 1, group = G_DET)
float minBodyPct = input.float(10.0, "Min body size (% of candle range)", minval = 0, maxval = 100, step = 5, group = G_DET,
     tooltip = "Filters tiny-body / big-wick candles. A body around 50% of the range (body and wicks even) is ideal.")
bool  freshOnly  = input.bool(true, "Fresh only (hide touched / testing zones)", group = G_DET,
     tooltip = "Only show zones price has never reached into. Off: touched and currently-tested zones are shown and labelled.")
float minBodyAtr = input.float(0.15, "Min body size (x ATR 14)", minval = 0, step = 0.05, group = G_DET,
     tooltip = "Skips 'junk' zones whose body is tiny next to the surrounding candles. Body must be at least this multiple of the 14-candle average true range. 0 = off.")
float touchBuf   = input.float(5.0, "Touch buffer (% of body)", minval = 0, maxval = 49, step = 1, group = G_DET,
     tooltip = "A wick may reach this far into the body (from either edge) without mitigating it. The zone is then marked as touched.")
int   maxTracked = input.int(300, "Max tracked candidates", minval = 50, maxval = 2000, group = G_DET,
     tooltip = "Performance cap. When exceeded, the oldest candidate that is not hidden yet is dropped.")

const string G_VIS = "Display"
bool  showBear  = input.bool(true, "Show bearish", group = G_VIS)
bool  showBull  = input.bool(true, "Show bullish", group = G_VIS)
color bearCol   = input.color(#C0501A, "Bearish colour", group = G_VIS)
color bullCol   = input.color(#1A8FC0, "Bullish colour", group = G_VIS)
bool  showMit   = input.bool(false, "Show mitigated hidden OBs (history)", group = G_VIS,
     tooltip = "Hidden OBs that price has since traded into. Useful for checking past reactions.")
int   maxMit    = input.int(50, "Max mitigated to show", minval = 1, maxval = 300, group = G_VIS)
color mitCol    = input.color(color.new(color.gray, 75), "Mitigated colour", group = G_VIS)
color touchCol  = input.color(#E8B931, "Touched zone border", group = G_VIS)

const string G_TBL = "Table"
bool   showTable = input.bool(true, "Show summary table", group = G_TBL)
int    tableRows = input.int(8, "Rows", minval = 1, maxval = 20, group = G_TBL)
string tablePos  = input.string("Top right", "Position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G_TBL)

type Zone
    int          barIdx
    int          openTime
    float        top
    float        bot
    float        bodyPct
    bool         bear
    bool         touched = false
    int          gapDir = 0
    int          hidden = 0
    int          endTime

tfLabel() =>
    string res = timeframe.period
    if timeframe.isminutes
        int m = timeframe.multiplier
        res := m % 60 == 0 ? str.tostring(m / 60, "#") + "H" : str.tostring(m) + "m"
    else if timeframe.multiplier == 1 and (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly)
        res := "1" + timeframe.period
    res

zoneColor(int hidden, color base) =>
    color.new(base, math.max(10, 70 - 15 * hidden))

var array<Zone> active    = array.new<Zone>()
var array<Zone> mitigated = array.new<Zone>()

bool levelUp   = false
bool mitigatedNow = false

// -- Update on closed candles only. Candle M = previous bar, its neighbours are bar[2] and the bar that just closed.
float atr14 = ta.atr(14)

// Each candle is judged when it closes. An FVG counts as soon as the candle that
// crosses the body has closed: the candle before it never touched the body and it
// traded straight through. If a later candle trades back into the body, that later
// candle is judged on its own and mitigates the zone.
if barstate.isconfirmed and bar_index >= 1
    int i = active.size() - 1
    while i >= 0
        Zone z = active.get(i)
        // Inner body = body minus the touch buffer at each edge. Reaching only into the
        // buffer is a touch (allowed, flagged); reaching the inner body must be an FVG.
        float buf     = (z.top - z.bot) * touchBuf / 100
        bool  inBody  = bar_index > z.barIdx and high > z.bot and low < z.top
        bool  inInner = inBody and high > z.bot + buf and low < z.top - buf
        bool  killed  = false
        if z.gapDir != 0
            // The candle after an FVG candle must leave the gap open, or there was no FVG.
            killed := z.gapDir > 0 ? high > z.bot + buf : low < z.top - buf
            z.gapDir := 0
        if not killed and inBody and bar_index == z.barIdx + 1
            // The move away: it may only cross the body by closing beyond the far side.
            killed := z.bear ? close <= z.top - buf : close >= z.bot + buf
            if not killed and (z.bear ? close <= z.top : close >= z.bot)
                z.touched := true
        else if not killed and inInner
            bool bearCover = low[1] >= z.top - buf and low <= z.bot + buf
            bool bullCover = high[1] <= z.bot + buf and high >= z.top - buf
            bool sameColour = (bearCover and z.bear) or (bullCover and not z.bear)
            // The first FVG must match the zone's colour; after that any covering FVG counts.
            if sameColour or ((bearCover or bullCover) and z.hidden > 0)
                z.hidden := z.hidden + 1
                z.gapDir := bearCover ? 1 : -1
                if z.hidden >= minHidden
                    levelUp := true
            else
                killed := true
        else if not killed and inBody
            z.touched := true
        if killed
            if z.hidden >= minHidden
                mitigatedNow := true
                z.endTime := time
                mitigated.push(z)
                if mitigated.size() > maxMit
                    mitigated.shift()
            active.remove(i)
        i -= 1

    // The candle that just closed becomes a new candidate.
    float bTop = math.max(open, close)
    float bBot = math.min(open, close)
    float rng  = high - low
    if rng > 0 and bTop > bBot
        float pct = (bTop - bBot) / rng * 100
        if pct >= minBodyPct and (na(atr14) or bTop - bBot >= minBodyAtr * atr14)
            active.push(Zone.new(barIdx = bar_index, openTime = time, top = bTop, bot = bBot, bodyPct = pct, bear = close < open))
            if active.size() > maxTracked
                int drop = 0
                for j = 0 to active.size() - 1
                    if active.get(j).hidden == 0
                        drop := j
                        break
                active.remove(drop)

// -- Live tap check (alerts)
bool tapping = false
for z in active
    if z.hidden >= minHidden and bar_index > z.barIdx + 1 and high > z.bot and low < z.top
        tapping := true

alertcondition(levelUp,      "Hidden OB formed / level up", "{{ticker}} {{interval}}: a hidden orderblock gained a hidden level")
alertcondition(tapping,      "Price tapping a hidden OB",   "{{ticker}} {{interval}}: price is trading into a hidden orderblock")
alertcondition(mitigatedNow, "Hidden OB mitigated",         "{{ticker}} {{interval}}: a hidden orderblock was mitigated")

// -- Drawing (rebuilt on the last bar only)
tablePosition(string s) =>
    switch s
        "Top right"    => position.top_right
        "Bottom right" => position.bottom_right
        "Top left"     => position.top_left
        => position.bottom_left

var array<box>   boxes  = array.new<box>()
var table        tbl    = table.new(tablePosition(tablePos), 5, 22, border_width = 1)

if barstate.islast
    for b in boxes
        b.delete()
    boxes.clear()
    tbl.clear(0, 0, 4, 21)

    string tf = tfLabel()

    if showMit
        for z in mitigated
            boxes.push(box.new(z.openTime, z.top, z.endTime, z.bot, xloc = xloc.bar_time, bgcolor = mitCol, border_color = mitCol,
                 text = str.format("{0}x {1}", z.hidden, tf), text_color = color.gray, text_size = size.tiny, text_halign = text.align_right))

    array<Zone>  shown   = array.new<Zone>()
    array<int>   shownN  = array.new<int>()
    array<bool>  shownF  = array.new<bool>()
    array<bool>  shownT  = array.new<bool>()
    array<float> scores  = array.new<float>()
    for z in active
        // Forming: the still-open candle is crossing the body as an FVG candle.
        // It is confirmed when that candle closes.
        bool  liveIn  = not barstate.isconfirmed and bar_index > z.barIdx + 1 and high > z.bot and low < z.top
        bool  touched = z.touched or (liveIn and not (high > z.bot + (z.top - z.bot) * touchBuf / 100 and low < z.top - (z.top - z.bot) * touchBuf / 100))
        float buf     = (z.top - z.bot) * touchBuf / 100
        bool  fBear   = low[1] >= z.top - buf and low <= z.bot + buf
        bool  fBull   = high[1] <= z.bot + buf and high >= z.top - buf
        bool  fSame   = (fBear and z.bear) or (fBull and not z.bear)
        bool  forming = liveIn and (fSame or ((fBear or fBull) and z.hidden > 0))
        // The open candle has already filled the gap left by the last FVG candle: there
        // was no FVG, and a high or low once reached can't be undone, so the zone is gone.
        bool  gapFill = not barstate.isconfirmed and z.gapDir != 0 and (z.gapDir > 0 ? high > z.bot + buf : low < z.top - buf)
        int   nHidden = z.hidden + (forming ? 1 : 0)
        bool  isBear  = (z.top + z.bot) / 2 > close
        float distPct = isBear ? (z.bot - close) / close * 100 : (close - z.top) / close * 100
        bool  stale   = freshOnly and (touched or (liveIn and not forming))
        if nHidden >= minHidden and not gapFill and not stale
            if (isBear and showBear) or (not isBear and showBull)
                color  base   = isBear ? bearCol : bullCol
                bool   tested = liveIn and not forming
                color  c      = zoneColor(nHidden, base)
                string note   = (forming ? "  forming" : tested ? "  testing" : "") + (touched ? "  touched" : "")
                boxes.push(box.new(z.openTime, z.top, time, z.bot, xloc = xloc.bar_time, extend = extend.right,
                     bgcolor = c, border_color = touched ? touchCol : c, border_width = touched ? 2 : 1,
                     border_style = forming or tested ? line.style_dashed : line.style_solid,
                     text = str.format("{0}x {1}{2}", nHidden, tf, note), text_color = color.white,
                     text_size = size.small, text_halign = text.align_right))
                shown.push(z)
                shownN.push(nHidden)
                shownF.push(forming)
                shownT.push(touched)
                scores.push(nHidden * 1000.0 - math.abs(distPct))

    if showTable
        table.cell(tbl, 0, 0, "HOB " + tf, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
        table.cell(tbl, 1, 0, "Hidden",    text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
        table.cell(tbl, 2, 0, "Zone",      text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
        table.cell(tbl, 3, 0, "Dist %",    text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
        table.cell(tbl, 4, 0, "Body %",    text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
        if shown.size() == 0
            table.cell(tbl, 0, 1, "none", text_color = color.gray, text_size = size.small)
        else
            array<int> ranked = scores.sort_indices(order.descending)
            int n = math.min(tableRows, ranked.size())
            for r = 0 to n - 1
                int   idx    = ranked.get(r)
                Zone  z      = shown.get(idx)
                bool  isBear = (z.top + z.bot) / 2 > close
                float dist   = isBear ? (z.bot - close) / close * 100 : (close - z.top) / close * 100
                color bg     = color.new(isBear ? bearCol : bullCol, 60)
                table.cell(tbl, 0, r + 1, isBear ? "Bear" : "Bull", text_color = color.white, bgcolor = bg, text_size = size.small)
                table.cell(tbl, 1, r + 1, str.tostring(shownN.get(idx)) + "x" + (shownF.get(idx) ? " forming" : "") + (shownT.get(idx) ? " touched" : ""), text_color = color.white, bgcolor = bg, text_size = size.small)
                table.cell(tbl, 2, r + 1, str.tostring(z.bot, format.mintick) + " - " + str.tostring(z.top, format.mintick), text_color = color.white, bgcolor = bg, text_size = size.small)
                table.cell(tbl, 3, r + 1, str.tostring(dist, "#.##"), text_color = color.white, bgcolor = bg, text_size = size.small)
                table.cell(tbl, 4, r + 1, str.tostring(z.bodyPct, "#"), text_color = color.white, bgcolor = bg, text_size = size.small)

// -- END OF SCRIPT -- if you can read this line in Pine Editor, the whole file was pasted.
